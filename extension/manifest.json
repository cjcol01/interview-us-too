{
  "manifest_version": 3,
  "name": "Interview Assistant",
  "version": "1.0",
  "description": "Capture your screen and get AI analysis on your phone.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Interview Assistant"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+7",
        "mac": "Command+Shift+7"
      },
      "description": "Capture current tab and analyze"
    },
    "toggle": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Toggle interview assistant on/off"
    }
  }
}
