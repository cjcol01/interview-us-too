{
  "manifest_version": 3,
  "name": "Smart Screen Assistant",
  "version": "1.2",
  "description": "Capture your screen or audio on any browser tab and get instant AI analysis and feedback.",
  "permissions": ["activeTab", "storage", "tabs", "offscreen", "tabCapture"],
  "host_permissions": ["https://interview-wise.com/*"],
  "commands": {
    "arm":     { "suggested_key": { "default": "Ctrl+Shift+1" }, "description": "Toggle on/off" },
    "capture": { "suggested_key": { "default": "Ctrl+Shift+6" }, "description": "Capture screen" },
    "mic":     { "suggested_key": { "default": "Ctrl+Shift+7" }, "description": "Hold to record voice" },
    "replay":  { "suggested_key": { "default": "Ctrl+Shift+8" }, "description": "Send instant replay" },
    "typing":  { "description": "Toggle typing mode" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Screen Assistant"
  },
  "content_scripts": [{
    "matches": ["https://interview-wise.com/*"],
    "js": ["content.js"]
  }]
}
